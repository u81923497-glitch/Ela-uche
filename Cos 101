from colorama import Fore, Back, Style, init

# Automatically enables colors on supported terminals
init(autoreset=True)

while True:
    print()
    print(Fore.CYAN + Style.BRIGHT + "================================")
    print(Fore.YELLOW + "       PHYSICS CALCULATOR")
    print(Fore.CYAN + "================================")

    print(Fore.GREEN + "1. Speed")
    print(Fore.BLUE + "2. Force")
    print(Fore.MAGENTA + "3. Weight")
    print(Fore.YELLOW + "4. Kinetic Energy")
    print(Fore.CYAN + "5. Work Done")
    print(Fore.RED + "6. Exit")

    choice = input(Fore.WHITE + "
Enter your choice (1-6): ")

    try:
        if choice == "1":
            print(Fore.GREEN + "
--- SPEED ---")
            distance = float(input("Enter distance: "))
            time = float(input("Enter time: "))

            if time == 0:
                print(Fore.RED + "Time cannot be zero.")
            else:
                speed = distance / time
                print(Fore.GREEN + f"Speed = {speed}")

        elif choice == "2":
            print(Fore.BLUE + "
--- FORCE ---")
            mass = float(input("Enter mass: "))
            acceleration = float(input("Enter acceleration: "))

            force = mass * acceleration
            print(Fore.BLUE + f"Force = {force} N")

        elif choice == "3":
            print(Fore.MAGENTA + "
--- WEIGHT ---")
            mass = float(input("Enter mass: "))
            gravity = 9.8

            weight = mass * gravity
            print(Fore.MAGENTA + f"Weight = {weight} N")

        elif choice == "4":
            print(Fore.YELLOW + "
--- KINETIC ENERGY ---")
            mass = float(input("Enter mass: "))
            velocity = float(input("Enter velocity: "))

            kinetic_energy = 0.5 * mass * velocity ** 2
            print(Fore.YELLOW + f"Kinetic Energy = {kinetic_energy} J")

        elif choice == "5":
            print(Fore.CYAN + "
--- WORK DONE ---")
            force = float(input("Enter force: "))
            distance = float(input("Enter distance: "))

            work = force * distance
            print(Fore.CYAN + f"Work Done = {work} J")

        elif choice == "6":
            print(Fore.RED + "
Thank you for using the Physics Calculator!")
            break

        else:
            print(Fore.RED + "Invalid choice! Please select between 1 and 6.")

    except ValueError:
        print(Fore.RED + "Invalid input! Please enter numbers only.")
